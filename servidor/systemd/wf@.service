# Um robô de coleta (wf@ativos, wf@fundos...): roda com o usuário wf, sem privilégios, e só pode gravar em /srv/wf.
[Unit]
Description=WF Investimentos: robô %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wf
Group=wf
Environment=WF=/srv/wf PY=/usr/bin/python3 TZ=America/Sao_Paulo
WorkingDirectory=/srv/wf/tmp
ExecStart=/srv/wf/codigo/servidor/rodar.sh %i
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
MemoryMax=5G
SuccessExitStatus=75
UMask=0027
# proteções do sistema
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/wf
ReadOnlyPaths=/srv/wf/codigo
InaccessiblePaths=-/etc/wf
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
