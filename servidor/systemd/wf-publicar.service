# Publica o app com os dados na Cloudflare. A chave da Cloudflare e o hash da senha do app são lidos pelo systemd
# de /etc/wf (arquivos que só o administrador lê) e entregues só a este serviço.
[Unit]
Description=WF Investimentos: publicar na Cloudflare
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wf
Group=wf
Environment=WF=/srv/wf PY=/usr/bin/python3 TZ=America/Sao_Paulo
EnvironmentFile=/etc/wf/cloudflare.env
EnvironmentFile=/etc/wf/app.env
WorkingDirectory=/srv/wf/publicar
ExecStart=/srv/wf/codigo/servidor/publicar.sh
TimeoutStartSec=1h
Nice=10
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/wf/publicar /srv/wf/tmp /srv/wf/home
ReadOnlyPaths=/srv/wf
InaccessiblePaths=-/etc/wf
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
